#ifndef SECRETS_H
#define SECRETS_H

// =================================================
// AIRGUARD ESP32 - LOCAL CONFIGURATION TEMPLATE
// =================================================
// Copy this file to "secrets.h" in the same directory and
// fill in your local Wi-Fi and device credentials.
// Note: "secrets.h" is ignored by Git to prevent committing secrets.

// Wi-Fi Credentials
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// AirGuard Backend Device Authentication Key (X-Device-Key)
#define DEVICE_API_KEY "YOUR_DEVICE_API_KEY"

#endif // SECRETS_H
